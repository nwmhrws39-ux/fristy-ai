{
  "name": "fristy-ai",
  "productName": "FRISTY AI",
  "version": "0.2.5",
  "description": "FRISTY AI - intelligent desktop assistant for Windows",
  "author": "FRISTY",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "dist": "node scripts/dist.mjs"
  },
  "devDependencies": {
    "@fontsource/rubik": "5.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.0.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "framer-motion": "11.11.17",
    "jsdom": "25.0.1",
    "lucide-react": "0.460.0",
    "postcss": "8.4.49",
    "rcedit": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  },
  "build": {
    "appId": "ai.fristy.desktop",
    "productName": "FRISTY AI",
    "copyright": "FRISTY",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../vendor/python",
        "to": "python"
      },
      {
        "from": "../backend/fristy",
        "to": "backend/fristy",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FRISTY AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "FRISTY-AI-Setup-${version}-x64.${ext}",
      "differentialPackage": false
    }
  }
}
